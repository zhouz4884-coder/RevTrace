{
  "schema_version": 1,
  "study": "RevBatch performance and exact-revision death gate",
  "decision_before_run": "D0_PASS_PROCEED_TO_PERFORMANCE_GATE",
  "hardware": {
    "primary": "2 x NVIDIA GeForce RTX 3090 24 GiB",
    "model_placement": {
      "Qwen3-ASR-0.6B": 0,
      "Qwen3-ASR-1.7B": 1
    }
  },
  "software": {
    "qwen3_asr_repository": "https://github.com/QwenLM/Qwen3-ASR.git",
    "qwen3_asr_commit": "7c6daf77a2421100f5fb066495372c00129d39ff",
    "qwen_asr_version": "0.0.6",
    "vllm_version": "0.14.0",
    "transformers_version": "4.57.6"
  },
  "models": [
    "Qwen/Qwen3-ASR-0.6B",
    "Qwen/Qwen3-ASR-1.7B"
  ],
  "streaming_contract": {
    "sample_rate_hz": 16000,
    "chunk_seconds": 2.0,
    "unfixed_chunk_num": 2,
    "unfixed_token_num": 5,
    "max_new_tokens": 32,
    "decoding": "greedy"
  },
  "workloads": {
    "concurrency_sweep": {
      "duration_seconds": 30,
      "concurrency": [1, 4, 8, 16, 32]
    },
    "duration_sweep": {
      "concurrency": 8,
      "duration_seconds": [15, 60, 120]
    },
    "session_languages": ["English", "Chinese"],
    "sources": [
      "Qwen3-ASR public English sample",
      "Qwen3-ASR public Chinese sample"
    ],
    "data_claim_boundary": "Performance and revision-equivalence only; no ASR quality or dataset-generalization claim."
  },
  "gate_a": {
    "required_for_both_models": true,
    "any_threshold": {
      "audio_throughput_speedup": 1.5,
      "slo_goodput_speedup": 1.5,
      "p99_reduction_fraction": 0.3
    }
  },
  "gate_b": {
    "minimum_chunk_events": 1000,
    "chunk_token_exact_match": 1.0,
    "chunk_transcript_exact_match": 1.0,
    "final_transcript_exact_match": 1.0
  },
  "gate_c": {
    "run_only_if_gate_a_and_gate_b_pass": true,
    "static_windows_ms": [0, 5, 10, 20, 50],
    "oracle_over_best_static": {
      "slo_goodput_speedup": 1.3,
      "p99_reduction_fraction": 0.3
    }
  },
  "sequential_stop": true,
  "evidence_boundary": "Only live RTX 3090 results count as Gate A/B evidence. Simulation is permitted only for Gate C policy sufficiency after empirical batch service times are collected."
}
