# Python and local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# IDE and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local runtime state
logs/*
tmp/*
.tmp/
.tmp_*
exports/*
.artifacts/*
!logs/.gitkeep
!tmp/.gitkeep
!exports/.gitkeep
!.artifacts/.gitkeep

# Large data and model state stay on the designated experiment disk.
data/
datasets/
models/
checkpoints/
cache/
runs/
profiles/

# Paper build products
Paper/*.aux
Paper/*.bbl
Paper/*.blg
Paper/*.log
Paper/*.out
Paper/*.spl
Paper/*.synctex.gz
Paper/main.pdf
Paper/template/
Paper/tmp/
Paper/figures/*.tiff

# Keep audited results and artifacts; raw transient runs belong on the server.
results/**/scratch/
results/**/unregistered/
results/_live*/
results/_live-*.json

# Phase 5 plotting is intentionally deferred until all experiments are frozen.
results/phase5/figures/
results/phase5/workload_matrix/*.json
!results/phase5/workload_matrix/SOURCE_MANIFEST.json

# Phase 6 live raw traces stay on the data disk; publish compact audited
# summaries plus hashes. No paper figures are generated before experiments end.
results/phase6/contract_scoping/0p6b-c32-d120-burst-zh.json
results/phase6/live_adaptation/c16-en-c16-zh-c16-en.json
results/phase6/live_adaptation/c16-en-c16-zh-c16-en-first-fail.json
results/phase6/live_adaptation/c16-en-c16-zh-c16-en-second-fail.json
results/phase6/figures/

# Local-only transfer bundles used to synchronize bounded remote artifacts.
_sync_*.tgz
_sync_*.tar
_revtrace_*_results.tgz

# Superseded R9 online-closure preview reruns. The frozen, independently
# finalized cells live in results/r9_dgft/service/online_closure_matrix/.
results/r9_dgft/online_closure/preview/

# Full remote engine logs contain transient topology details; compact JSON
# evidence, exit codes, and hashes are the publication artifacts.
results/checkpoint20_ordinary_authority/*.log
results/checkpoint20_holdback_authority/*.log
