#!/usr/bin/env bash
#PBS -N revtrace-v100-setup
#PBS -q GPUDefq
#PBS -l nodes=gpu2:ppn=36:gpus=8
#PBS -j oe

set -euo pipefail

ROOT="/data/home/${USER}/revtrace_v100"
SRC="$ROOT/code/RevTrace"
PERSISTENT_ENV="$ROOT/env/revtrace-v100-cu121"
LOCAL_ROOT="/tmp/${USER}/revtrace-v100-runtime"
ENV="$LOCAL_ROOT/revtrace-v100-cu121"
BASE_ENV="/data/home/${USER}/contractkv_v100/env/contractkv-v100-cu121"
MM="/data/home/${USER}/contractkv_v100/tools/micromamba/micromamba"
JOB_TAG="${PBS_JOBID:-manual}"
OUT="$ROOT/results/v0/$JOB_TAG"
LOG="$ROOT/logs/v0/$JOB_TAG.log"

mkdir -p "$OUT" "$(dirname "$LOG")" "$LOCAL_ROOT" \
  "$ROOT/models" "$ROOT/datasets" "$ROOT/cache/pip" "$ROOT/cache/hf"
exec > >(tee "$LOG") 2>&1

[[ "$(hostname -s)" == "gpu2" ]] || {
  echo "Expected gpu2, got $(hostname -s)" >&2
  exit 42
}

echo "REVTRACE_V100_SETUP_BEGIN"
date -Is
hostname
nvidia-smi -L
nvidia-smi topo -m

if [[ -x "$PERSISTENT_ENV/bin/python" ]]; then
  rm -rf "$ENV"
  tar -C "$(dirname "$PERSISTENT_ENV")" -cf - "$(basename "$PERSISTENT_ENV")" | \
    tar -C "$LOCAL_ROOT" -xf -
elif [[ -x "$BASE_ENV/bin/python" ]]; then
  rm -rf "$ENV"
  tar -C "$(dirname "$BASE_ENV")" -cf - "$(basename "$BASE_ENV")" | \
    tar -C "$LOCAL_ROOT" -xf -
  mv "$LOCAL_ROOT/$(basename "$BASE_ENV")" "$ENV"
else
  [[ -x "$MM" ]] || { echo "micromamba missing: $MM" >&2; exit 2; }
  "$MM" create -y --no-rc --override-channels \
    -r "$LOCAL_ROOT/micromamba-root" -p "$ENV" \
    -c https://mirrors.tuna.tsinghua.edu.cn/anaconda/cloud/pytorch/ \
    -c https://mirrors.tuna.tsinghua.edu.cn/anaconda/cloud/conda-forge/ \
    -c https://repo.anaconda.com/pkgs/main/ \
    -c https://conda.anaconda.org/nvidia/ \
    python=3.10 pytorch=2.4.1 torchvision=0.19.1 torchaudio=2.4.1 \
    pytorch-cuda=12.1
fi

export PIP_CACHE_DIR="$ROOT/cache/pip"
export HF_HOME="$ROOT/cache/hf"
export TRANSFORMERS_CACHE="$HF_HOME/transformers"
export MODELSCOPE_CACHE="$ROOT/cache/modelscope"
export MODELSCOPE_DOWNLOAD_FILE_LOCK=false
export TOKENIZERS_PARALLELISM=false

if [[ ! -f "$ENV/.revtrace_packages_ready" ]]; then
"$ENV/bin/python" -m pip install --force-reinstall --no-deps \
  -i https://pypi.tuna.tsinghua.edu.cn/simple typing_extensions==4.12.2
"$ENV/bin/python" -m pip install --no-deps \
  -i https://pypi.tuna.tsinghua.edu.cn/simple qwen-asr==0.0.6
"$ENV/bin/python" -m pip install \
  -i https://pypi.tuna.tsinghua.edu.cn/simple \
  transformers==4.57.6 accelerate==1.12.0 \
  numpy==1.23.4 scipy==1.9.3 \
  numba==0.60.0 llvmlite==0.43.0 soxr==0.3.7 \
  librosa==0.10.2.post1 soundfile==0.12.1 \
  nagisa==0.2.11 soynlp==0.0.493 pytz \
  modelscope psutil pynvml requests==2.32.4 \
  charset-normalizer==3.4.3 chardet==5.2.0 idna==3.10 \
  urllib3==2.5.0 certifi==2025.8.3
touch "$ENV/.revtrace_packages_ready"
rm -rf "$PERSISTENT_ENV"
mkdir -p "$(dirname "$PERSISTENT_ENV")"
tar -C "$LOCAL_ROOT" -cf - "$(basename "$ENV")" | \
  tar -C "$(dirname "$PERSISTENT_ENV")" -xf -
fi

download_model() {
  local model_id="$1"
  local destination="$2"
  if [[ -s "$destination/config.json" ]]; then
    echo "MODEL_PRESENT $destination"
    return
  fi
  rm -rf "$destination.partial"
  "$ENV/bin/python" - "$model_id" "$destination.partial" <<'PY'
import sys
from modelscope import snapshot_download

model_id, destination = sys.argv[1:]
snapshot_download(model_id, local_dir=destination)
PY
  mv "$destination.partial" "$destination"
}

download_model Qwen/Qwen3-ASR-0.6B "$ROOT/models/Qwen3-ASR-0.6B"
download_model Qwen/Qwen3-ASR-1.7B "$ROOT/models/Qwen3-ASR-1.7B"

"$ENV/bin/python" "$SRC/scripts/remote/prepare_revbatch_data.py" \
  --root "$ROOT/datasets/revbatch"

"$ENV/bin/python" "$SRC/scripts/v100/v100_hf_smoke.py" \
  --root "$ROOT" --output "$OUT/smoke.json"

"$ENV/bin/python" -m pip freeze > "$OUT/pip_freeze.txt"
"$ENV/bin/python" - <<'PY' > "$OUT/environment.json"
import json, os, platform
import torch, transformers
payload = {
    "hostname": platform.node(),
    "python": platform.python_version(),
    "torch": torch.__version__,
    "torch_cuda": torch.version.cuda,
    "transformers": transformers.__version__,
    "cuda_available": torch.cuda.is_available(),
    "gpu_count": torch.cuda.device_count(),
    "gpus": [torch.cuda.get_device_name(i) for i in range(torch.cuda.device_count())],
    "pbs_jobid": os.environ.get("PBS_JOBID"),
}
print(json.dumps(payload, indent=2, sort_keys=True))
PY

rm -rf "$PERSISTENT_ENV"
mkdir -p "$(dirname "$PERSISTENT_ENV")"
tar -C "$LOCAL_ROOT" -cf - "$(basename "$ENV")" | \
  tar -C "$(dirname "$PERSISTENT_ENV")" -xf -

echo "REVTRACE_V100_SETUP_COMPLETE"
