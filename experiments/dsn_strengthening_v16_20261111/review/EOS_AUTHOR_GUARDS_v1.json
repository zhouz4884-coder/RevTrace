  "lines": [
    {
      "line": 833,
      "text": "        infer_start_time = start_time"
    },
    {
      "line": 834,
      "text": "        "
    },
    {
      "line": 835,
      "text": "        new_segment = True"
    },
    {
      "line": 836,
      "text": "        if len(self.segments) == 0:"
    },
    {
      "line": 837,
      "text": "            logger.debug(\"No segments, nothing to do\")"
    },
    {
      "line": 838,
      "text": "            # self.logdir_save([], [], {})"
    },
    {
      "line": 839,
      "text": "            return [], {}"
    },
    {
      "line": 840,
      "text": "        if not self._apply_minseglen():"
    },
    {
      "line": 841,
      "text": "            logger.debug(f\"applied minseglen {self.cfg.audio_min_len} > {self.segments_len()}.\")"
    },
    {
      "line": 842,
      "text": "            input_segments = torch.cat(self.segments, dim=0)"
    },
    {
      "line": 843,
      "text": "            # self.logdir_save(input_segments, [], {})"
    },
    {
      "line": 844,
      "text": "            return [], {}"
    },
    {
      "line": 845,
      "text": ""
    },
    {
      "line": 846,
      "text": "        # input_segments is concatenation of audio, it's one array"
    },
    {
      "line": 847,
      "text": "        if len(self.segments) > 1:"
    },
    {
      "line": 848,
      "text": "            input_segments = torch.cat(self.segments, dim=0)"
    },
    {
      "line": 849,
      "text": "        else:"
    },
    {
      "line": 850,
      "text": "            input_segments = self.segments[0]"
    },
    {
      "line": 851,
      "text": "        "
    },
    {
      "line": 852,
      "text": "        # mel + padding to 30s"
    },
    {
      "line": 853,
      "text": "        mel_padded = log_mel_spectrogram("
    },
    {
      "line": 854,
      "text": "            input_segments,"
    },
    {
      "line": 855,
      "text": "            n_mels=self.model.dims.n_mels,"
    },
    {
      "line": 856,
      "text": "            padding=N_SAMPLES,"
    },
    {
      "line": 857,
      "text": "            device=self.model.device"
    },
    {
      "line": 858,
      "text": "        ).unsqueeze(0)"
    },
    {
      "line": 859,
      "text": "        # Trim to 3000"
    },
    {
      "line": 860,
      "text": "        mel = pad_or_trim(mel_padded, N_FRAMES)"
    },
    {
      "line": 861,
      "text": ""
    },
    {
      "line": 862,
      "text": "        # The length of actual audio"
    },
    {
      "line": 863,
      "text": "        content_mel_len = int((mel_padded.shape[2] - mel.shape[2]) / 2)"
    },
    {
      "line": 864,
      "text": ""
    },
    {
      "line": 865,
      "text": "        # Encode"
    },
    {
      "line": 866,
      "text": "        encoder_feature = self.model.encoder(mel)"
    },
    {
      "line": 867,
      "text": ""
    },
    {
      "line": 868,
      "text": "        if self.cfg.language == \"auto\" and self.detected_language is None:"
    },
    {
      "line": 869,
      "text": "            language_tokens, language_probs = self.lang_id(encoder_feature) "
    },
    {
      "line": 870,
      "text": "            logger.debug(f\"Language tokens: {language_tokens}, probs: {language_probs}\")"
    },
    {
      "line": 871,
      "text": "            top_lan, p = max(language_probs[0].items(), key=lambda x: x[1])"
    },
    {
      "line": 872,
      "text": "            logger.info(f\"Detected language: {top_lan} with p={p:.4f}\")"
    },
    {
      "line": 873,
      "text": "            #self.tokenizer.language = top_lan"
    },
    {
      "line": 874,
      "text": "            #self.tokenizer.__post_init__()"
    },
    {
      "line": 875,
      "text": "            self.create_tokenizer(top_lan)"
    },
    {
      "line": 876,
      "text": "            self.detected_language = top_lan"
    },
    {
      "line": 877,
      "text": "            self.init_tokens()"
    },
    {
      "line": 878,
      "text": "            logger.info(f\"Tokenizer language: {self.tokenizer.language}, {self.tokenizer.sot_sequence_including_notimestamps}\")"
    },
    {
      "line": 879,
      "text": ""
    },
    {
      "line": 880,
      "text": "        self.trim_context()"
    },
    {
      "line": 881,
      "text": "        current_tokens = self._current_tokens()"
    },
    {
      "line": 882,
      "text": ""
    },
    {
      "line": 883,
      "text": "        fire_detected = self.fire_at_boundary(encoder_feature[:, :content_mel_len, :])"
    },
    {
      "line": 884,
      "text": ""
    },
    {
      "line": 885,
      "text": "        # ==================== Decoding Loop ===================="
    },
    {
      "line": 1040,
      "text": ""
    },
    {
      "line": 1041,
      "text": "            # Debug print"
    },
    {
      "line": 1042,
      "text": "            for i in range(self.cfg.beam_size):"
    },
    {
      "line": 1043,
      "text": "                logger.debug("
    },
    {
      "line": 1044,
      "text": "                    \"attn: {}, current pos: {}, current token: {}({})\".format("
    },
    {
      "line": 1045,
      "text": "                        attn_of_alignment_heads.shape if attn_of_alignment_heads is not None else None,"
    },
    {
      "line": 1046,
      "text": "                        most_attended_frames[i],"
    },
    {
      "line": 1047,
      "text": "                        current_tokens[i, -1].item(),"
    },
    {
      "line": 1048,
      "text": "                        self.tokenizer.decode([current_tokens[i, -1].item()])"
    },
    {
      "line": 1049,
      "text": "                    )"
    },
    {
      "line": 1050,
      "text": "                )"
    },
    {
      "line": 1051,
      "text": ""
    },
    {
      "line": 1052,
      "text": "        # Error Corrector"
    },
    {
      "line": 1053,
      "text": "        use_error_corrector = False"
    },
    {
      "line": 1054,
      "text": "        # For SpeechLM corrector, we need corrector_processor (which is the Ultravox processor)"
    },
    {
      "line": 1055,
      "text": "        # For LM corrector, corrector_processor is actually the tokenizer"
    },
    {
      "line": 1056,
      "text": "        if token_len_before_decoding > 0 and not self.is_warmup and corrector_model is not None:"
    },
    {
      "line": 1057,
      "text": "            use_error_corrector = True"
    },
    {
      "line": 1058,
      "text": "            error_corrector_start = time.time()"
    },
    {
      "line": 1059,
      "text": ""
    },
    {
      "line": 1060,
      "text": "            "
    },
    {
      "line": 1061,
      "text": "            estimated_run_time_start = time.time()"
    },
    {
      "line": 1062,
      "text": ""
    },
    {
      "line": 1063,
      "text": "            if corrector_type == \"lm\":"
    },
    {
      "line": 1064,
      "text": "                # LM corrector (text-only, Llama with LoRA)"
    },
    {
      "line": 1065,
      "text": "                corrector_result = self._run_LM_error_corrector("
    },
    {
      "line": 1066,
      "text": "                    current_tokens=current_tokens,"
    },
    {
      "line": 1067,
      "text": "                    token_len_before_decoding=token_len_before_decoding,"
    },
    {
      "line": 1068,
      "text": "                    corrector_model=corrector_model,"
    },
    {
      "line": 1069,
      "text": "                    corrector_tokenizer=corrector_processor,  # For LM, processor is actually the tokenizer"
    },
    {
      "line": 1070,
      "text": "                )"
    },
    {
      "line": 1071,
      "text": "            else:"
    },
    {
      "line": 1072,
      "text": "                # SpeechLM corrector (audio + text, Ultravox with LoRA)"
    },
    {
      "line": 1073,
      "text": "                corrector_result = self._run_SpeechLM_error_corrector("
    },
    {
      "line": 1074,
      "text": "                    input_audio=input_segments,"
    }
  ]
}
