        {
          "line": 210,
          "text": "def _download(url: str, root: str, in_memory: bool) -> Union[bytes, str]:"
        },
        {
          "line": 211,
          "text": "    os.makedirs(root, exist_ok=True)"
        },
        {
          "line": 212,
          "text": ""
        },
        {
          "line": 213,
          "text": "    expected_sha256 = url.split(\"/\")[-2]"
        },
        {
          "line": 214,
          "text": "    download_target = os.path.join(root, os.path.basename(url))"
        },
        {
          "line": 215,
          "text": ""
        },
        {
          "line": 216,
          "text": "    if os.path.exists(download_target) and not os.path.isfile(download_target):"
        },
        {
          "line": 217,
          "text": "        raise RuntimeError(f\"{download_target} exists and is not a regular file\")"
        },
        {
          "line": 218,
          "text": "        "
        },
        {
          "line": 219,
          "text": "    if os.path.isfile(download_target):"
        },
        {
          "line": 220,
          "text": "        with open(download_target, \"rb\") as f:"
        },
        {
          "line": 221,
          "text": "            model_bytes = f.read()"
        },
        {
          "line": 222,
          "text": "        if hashlib.sha256(model_bytes).hexdigest() == expected_sha256:"
        },
        {
          "line": 223,
          "text": "            return model_bytes if in_memory else download_target"
        },
        {
          "line": 224,
          "text": "        else:"
        },
        {
          "line": 225,
          "text": "            warnings.warn("
        },
        {
          "line": 226,
          "text": "                f\"{download_target} exists, but the SHA256 checksum does not match; re-downloading the file\""
        },
        {
          "line": 227,
          "text": "            )"
        },
        {
          "line": 228,
          "text": ""
        },
        {
          "line": 229,
          "text": "    with urllib.request.urlopen(url) as source, open(download_target, \"wb\") as output:"
        },
        {
          "line": 230,
          "text": "        with tqdm("
        },
        {
          "line": 231,
          "text": "            total=int(source.info().get(\"Content-Length\")),"
        },
        {
          "line": 232,
          "text": "            ncols=80,"
        },
        {
          "line": 233,
          "text": "            unit=\"iB\","
        },
        {
          "line": 234,
          "text": "            unit_scale=True,"
        },
        {
          "line": 235,
          "text": "            unit_divisor=1024,"
        }
      ]
    },
