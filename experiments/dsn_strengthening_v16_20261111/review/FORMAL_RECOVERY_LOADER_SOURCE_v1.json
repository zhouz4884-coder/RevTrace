          "text": "                    torch_dtype=config.torch_dtype,"
        },
        {
          "line": 518,
          "text": "                )"
        },
        {
          "line": 519,
          "text": ""
        },
        {
          "line": 520,
          "text": "        language_model = apply_lora(language_model, config.text_model_lora_config)"
        },
        {
          "line": 521,
          "text": "        return language_model"
        },
        {
          "line": 522,
          "text": ""
