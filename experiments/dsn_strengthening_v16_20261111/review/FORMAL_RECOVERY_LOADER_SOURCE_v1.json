        {
          "line": 523,
          "text": "    def merge_and_unload(self):"
        },
        {
          "line": 524,
          "text": "        if isinstance(self.language_model, peft.PeftModel):"
        },
        {
          "line": 525,
          "text": "            self.language_model = self.language_model.merge_and_unload()"
        },
        {
          "line": 526,
          "text": "            # no need to download base language model weights anymore, so we can remove the id"
