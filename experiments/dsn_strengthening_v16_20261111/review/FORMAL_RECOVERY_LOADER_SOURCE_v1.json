        {
          "line": 133,
          "text": "def convert_wenet_to_whisper_state_dict(wenet_state_dict):"
        },
        {
          "line": 134,
          "text": "    \"\"\""
        },
        {
          "line": 135,
          "text": "    Convert WeNet model state dict to Whisper model state dict by renaming keys."
        },
        {
          "line": 136,
          "text": "    "
        },
        {
          "line": 137,
          "text": "    Args:"
        },
        {
          "line": 138,
          "text": "        wenet_state_dict: Dictionary containing WeNet model parameters"
        },
        {
          "line": 139,
          "text": "        "
        },
        {
          "line": 140,
          "text": "    Returns:"
        },
        {
          "line": 141,
          "text": "        whisper_state_dict: Dictionary with keys renamed to match Whisper format"
        },
        {
          "line": 142,
          "text": "    \"\"\""
        },
        {
          "line": 143,
          "text": "    whisper_state_dict = {}"
        },
        {
          "line": 144,
          "text": "    "
        },
        {
          "line": 145,
          "text": "    for name in wenet_state_dict.keys():"
        },
        {
          "line": 146,
          "text": "        original_name = copy.deepcopy(name)"
        },
        {
          "line": 147,
          "text": "        "
        },
        {
          "line": 148,
          "text": "        # Skip WeNet-specific keys that don't exist in Whisper"
        },
        {
          "line": 149,
          "text": "        if (name.startswith(\"ctc.\") or "
        },
        {
          "line": 150,
          "text": "            name == \"model_state_dict\" or "
        },
        {
          "line": 151,
          "text": "            name == \"dims\" or"
        },
        {
          "line": 152,
          "text": "            name == \"decoder.output_layer.weight\" or"
        },
        {
          "line": 153,
          "text": "            name == \"decoder.output_layer.bias\"):"
        },
        {
          "line": 154,
          "text": "            continue"
        },
        {
          "line": 155,
          "text": "        "
        },
        {
          "line": 156,
          "text": "        # Handle positional embeddings first (special case with squeeze)"
        },
        {
          "line": 157,
          "text": "        if original_name == \"encoder.embed.pos_enc.pe\":"
        },
        {
          "line": 158,
          "text": "            name = \"encoder.positional_embedding\""
        },
        {
          "line": 159,
          "text": "            whisper_state_dict[name] = wenet_state_dict[original_name].squeeze(0)"
        },
        {
          "line": 160,
          "text": "        elif original_name == \"decoder.embed.1.pe\":"
        },
        {
          "line": 161,
          "text": "            name = \"decoder.positional_embedding\""
        },
        {
          "line": 162,
          "text": "            whisper_state_dict[name] = wenet_state_dict[original_name].squeeze(0)"
        },
        {
          "line": 163,
          "text": "        else:"
        },
        {
          "line": 164,
          "text": "            # Apply reverse string replacements in correct order"
        },
        {
          "line": 165,
          "text": "            # Convolution layers"
        },
        {
          "line": 166,
          "text": "            name = name.replace(\"encoder.embed.conv.0\", \"encoder.conv1\")"
        },
        {
          "line": 167,
          "text": "            name = name.replace(\"encoder.embed.conv.2\", \"encoder.conv2\")"
        },
        {
          "line": 168,
          "text": "            "
        },
        {
          "line": 169,
          "text": "            # Token embedding"
        },
        {
          "line": 170,
          "text": "            name = name.replace(\"decoder.embed.0\", \"decoder.token_embedding\")"
        },
        {
          "line": 171,
          "text": "            "
        },
        {
          "line": 172,
          "text": "            # Encoder/Decoder blocks"
        },
        {
          "line": 173,
          "text": "            name = name.replace(\"encoder.encoders\", \"encoder.blocks\")"
        },
        {
          "line": 174,
          "text": "            name = name.replace(\"decoder.decoders\", \"decoder.blocks\")"
        },
        {
          "line": 175,
          "text": "            "
        },
        {
          "line": 176,
          "text": "            # Cross attention (decoder only)"
        },
        {
          "line": 177,
          "text": "            name = name.replace(\".src_attn.linear_q\", \".cross_attn.query\")"
        },
        {
          "line": 178,
          "text": "            name = name.replace(\".src_attn.linear_k\", \".cross_attn.key\")"
        },
        {
          "line": 179,
          "text": "            name = name.replace(\".src_attn.linear_v\", \".cross_attn.value\")"
        },
        {
          "line": 180,
          "text": "            name = name.replace(\".src_attn.linear_out\", \".cross_attn.out\")"
        },
        {
          "line": 181,
          "text": "            "
        },
        {
          "line": 182,
          "text": "            # Self attention"
        },
        {
          "line": 183,
          "text": "            name = name.replace(\".self_attn.linear_q\", \".attn.query\")"
        },
        {
          "line": 184,
          "text": "            name = name.replace(\".self_attn.linear_k\", \".attn.key\")"
        },
        {
          "line": 185,
          "text": "            name = name.replace(\".self_attn.linear_v\", \".attn.value\")"
        },
        {
          "line": 186,
          "text": "            name = name.replace(\".self_attn.linear_out\", \".attn.out\")"
        },
        {
          "line": 187,
          "text": "            "
        },
        {
          "line": 188,
          "text": "            # Feed forward layers"
        },
        {
          "line": 189,
          "text": "            name = name.replace(\"feed_forward.w_1\", \"mlp.0\")"
        },
        {
          "line": 190,
          "text": "            name = name.replace(\"feed_forward.w_2\", \"mlp.2\")"
        },
        {
          "line": 191,
          "text": "            "
        },
        {
          "line": 192,
          "text": "            # Normalization layers - handle decoder first (more specific)"
        },
        {
          "line": 193,
          "text": "            if \"decoder\" in name:"
        },
        {
          "line": 194,
          "text": "                name = name.replace(\"norm2\", \"cross_attn_ln\")"
        },
        {
          "line": 195,
          "text": "                name = name.replace(\"norm3\", \"mlp_ln\")"
        },
        {
          "line": 196,
          "text": "                name = name.replace(\"norm1\", \"attn_ln\")"
        },
        {
          "line": 197,
          "text": "            else:"
        },
        {
          "line": 198,
          "text": "                name = name.replace(\"norm2\", \"mlp_ln\")"
        },
        {
          "line": 199,
          "text": "                name = name.replace(\"norm1\", \"attn_ln\")"
        },
        {
          "line": 200,
          "text": "            "
        },
        {
          "line": 201,
          "text": "            # Post-encoder/decoder normalization"
        },
        {
          "line": 202,
          "text": "            name = name.replace(\"encoder.after_norm\", \"encoder.ln_post\")"
        },
        {
          "line": 203,
          "text": "            name = name.replace(\"decoder.after_norm\", \"decoder.ln\")"
        },
        {
          "line": 204,
          "text": "            "
        },
        {
          "line": 205,
          "text": "            whisper_state_dict[name] = wenet_state_dict[original_name]"
        },
        {
          "line": 206,
          "text": "    "
        },
        {
          "line": 207,
          "text": "    return whisper_state_dict"
        },
