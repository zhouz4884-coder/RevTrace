          "text": "            language_model = transformers.AutoModelForCausalLM.from_pretrained("
        },
        {
          "line": 503,
          "text": "                config.text_model_id,"
        },
        {
          "line": 504,
          "text": "                **{"
        },
        {
          "line": 505,
          "text": "                    \"attn_implementation\": config.text_config._attn_implementation,"
        },
        {
          "line": 506,
          "text": "                    \"torch_dtype\": config.torch_dtype,"
        },
        {
          "line": 507,
          "text": "                    **FROM_PRETRAINED_KWARGS,"
        },
        {
          "line": 508,
          "text": "                },"
        },
        {
          "line": 509,
          "text": "            )"
        },
        {
          "line": 510,
          "text": "        else:"
        },
        {
          "line": 511,
          "text": "            with accelerate.init_empty_weights():"
        },
        {
          "line": 512,
          "text": "                # we only ever use from_config if the weights are retrained, hence initializing is not"
        },
        {
          "line": 513,
          "text": "                # required. This makes the model quite creation faster since init on CPU is quite slow."
        },
        {
          "line": 514,
          "text": "                language_model = transformers.AutoModelForCausalLM.from_config("
        },
        {
          "line": 515,
          "text": "                    config.text_config,"
        },
        {
          "line": 516,
          "text": "                    attn_implementation=config.text_config._attn_implementation,"
