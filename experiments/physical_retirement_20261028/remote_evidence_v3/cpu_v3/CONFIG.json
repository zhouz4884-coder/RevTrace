  "controller_source": "from pathlib import Path\nimport hashlib,json,os,subprocess,time,traceback,xml.etree.ElementTree as ET\nfrom retirement_service import verify_source\nD=Path('/media/user/5bc0dc8d-c938-4b2a-af1b-94174fc511a9/results/revtrace/physical_retirement_20261028/cpu_v3')\ndef put(path,value):\n    with path.open('x',encoding='utf8') as stream:json.dump(value,stream,indent=2);stream.write('\\n')\ncfg=json.loads((D/'CONFIG.json').read_text());begin=time.perf_counter()\ntry:\n    before=verify_source(Path(cfg['source_manifest']),Path(cfg['source']))\n    with (D/'pytest.log').open('x') as stream:\n        run=subprocess.run(cfg['argv'],cwd=cfg['source'],env=os.environ,stdout=stream,stderr=subprocess.STDOUT,timeout=600)\n    after=verify_source(Path(cfg['source_manifest']),Path(cfg['source']))\n    suites=list(ET.parse(D/'results.xml').getroot().iter('testsuite'))\n    counts={key:sum(int(s.attrib.get(key,0)) for s in suites) for key in ['tests','failures','errors','skipped']}\n    summary=dict(status='COMPLETE_CPU_GATE',returncode=run.returncode,counts=counts,modules=len(cfg['tests']),\n        code_commit=cfg['code_commit'],source_manifest_sha256=cfg['source_manifest_sha256'],\n        wall_seconds=time.perf_counter()-begin,new_GPU_calls=0,source_before=before,source_after=after)\n    put(D/'SUMMARY.json',summary)\n    put(D/'GATE.json',dict(gate='PASS' if run.returncode==0 and counts['errors']==counts['failures']==0 else 'FAIL',**summary))\n    print(json.dumps(summary),flush=True)\nexcept BaseException:\n    failure=dict(gate='FAIL_RETAINED',traceback=traceback.format_exc(),code_commit=cfg['code_commit'],new_GPU_calls=0)\n    put(D/'STOP.json',failure)\n    if not (D/'GATE.json').exists():put(D/'GATE.json',failure)\n    raise\n",
