{
  "experiment_id": "REVTRACE-S2-TERMINAL-RESERVED-V1",
  "study": "RevTrace terminal-reserved exact revision transactions",
  "models": [
    "Qwen3-ASR-0.6B",
    "Qwen3-ASR-1.7B"
  ],
  "frozen_service_workload": {
    "duration_seconds": 30,
    "concurrency": 16,
    "chunk_seconds": 2,
    "dtype": "float16",
