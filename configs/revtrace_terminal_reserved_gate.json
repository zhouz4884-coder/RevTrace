  },
  "gates": {
    "maximum_state_entry_deadline_miss_rate": 0.01,
    "minimum_wall_speedup": 4.0,
    "minimum_gpu_normalized_speedup": 2.0,
    "maximum_output_violations": 0,
    "maximum_state_projection_violations": 0,
    "maximum_stale_or_replayed_commits": 0,
    "maximum_verifier_to_proposer_service_ratio": 0.8
  },
  "contract": {
    "canonical": "FP16 singleton execution",
    "terminal": "every terminal revision is verified",
    "state_entry": "no uncertified exact-mode result may update state",
    "scheduling": "terminal bursts use isolated BS=1 lanes and per-item commit",
    "evidence": "all performance gates use measured two-GPU wall clock"
  }
}
