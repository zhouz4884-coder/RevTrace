      "speaker_id": "1284",
      "split": "test-clean",
      "text": "WHEN THEY WERE OUTSIDE UNC SIMPLY LATCHED THE DOOR AND STARTED UP THE PATH",
      "utterance_id": "1284-1180-0004"
    },
    {
      "path": "/media/user/5bc0dc8d-c938-4b2a-af1b-94174fc511a9/datasets/revtrace/librispeech/LibriSpeech/test-clean/1284/1180/1284-1180-0028.flac",
