      "text": "ANGOR PAIN PAINFUL TO HEAR",
      "utterance_id": "121-121726-0002"
    },
    {
      "path": "/media/user/5bc0dc8d-c938-4b2a-af1b-94174fc511a9/datasets/revtrace/librispeech/LibriSpeech/test-clean/1221/135766/1221-135766-0003.flac",
