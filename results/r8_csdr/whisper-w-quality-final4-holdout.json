      "utterance_id": "2094-142345-0039"
    },
    {
      "path": "/media/user/5bc0dc8d-c938-4b2a-af1b-94174fc511a9/datasets/revtrace/librispeech/LibriSpeech/test-clean/2094/142345/2094-142345-0047.flac",
